{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@anselse/vocab": ["packages/vocab/src/index.ts"],
      "@anselse/recipe": ["packages/recipe/src/index.ts"],
      "@anselse/events": ["packages/events/src/index.ts"],
      "@anselse/db": ["packages/db/src/index.ts"],
      "@anselse/adapters": ["packages/adapters/src/index.ts"],
      "@anselse/platform": ["packages/platform/src/index.ts"],
      "@anselse/server": ["apps/server/src/index.ts"],
      "@anselse/worker": ["apps/worker/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/tests/**/*.ts"
  ],
  "exclude": ["**/node_modules", "apps/web"]
}
